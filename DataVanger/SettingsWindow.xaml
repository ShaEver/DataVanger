<Window x:Class="DataVanger.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataVanger — Configurações"
        Width="720" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Configurações do scanner" FontSize="18" FontWeight="Bold" Foreground="#00bbdd" Margin="0,0,0,14"/>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Pastas extras para varrer — uma por linha" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtExtraTargets" Height="78" Margin="0,4,0,12" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8"/>

        <TextBlock Text="Pastas excluídas — uma por linha" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtExcludedPaths" Height="78" Margin="0,4,0,12" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8"/>

        <TextBlock Text="Publishers confiáveis extras — um por linha (somados aos confiáveis padrão; assinatura confiável não anula hash malicioso)" Foreground="#888" FontSize="12" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtTrustedPublishers" Height="64" Margin="0,4,0,12" AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8"/>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Score mínimo para relatório" Foreground="#888" FontSize="12"/>
            <TextBox x:Name="TxtMinScoreReport" Height="30" Margin="0,4,0,0"
                     Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Score mínimo para quarentena" Foreground="#888" FontSize="12"/>
            <TextBox x:Name="TxtMinScoreQuarantine" Height="30" Margin="0,4,0,0"
                     Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="URL para atualizar known_malicious_sha256.txt" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtSignatureUpdateUrl" Height="30" Margin="0,4,0,12"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>

        <TextBlock Text="— Feed de atualização assinado (opt-in; ative o toggle 'Atualizações assinadas via HTTP') —"
                   Foreground="#00bbdd" FontSize="12" FontWeight="Bold" Margin="0,4,0,4" TextWrapping="Wrap"/>
        <TextBlock Text="URL do feed assinado (HTTPS)" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtSignedUpdateFeedUrl" Height="30" Margin="0,4,0,8"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
        <TextBlock Text="ID da chave fixada (Key ID)" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtSignedUpdateKeyId" Height="30" Margin="0,4,0,8"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
        <TextBlock Text="Algoritmo (RSA-PSS-SHA256 ou ECDsa-P256-SHA256)" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtSignedUpdateAlgorithm" Height="30" Margin="0,4,0,8"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
        <TextBlock Text="ID do feed" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtSignedUpdateFeedId" Height="30" Margin="0,4,0,8"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
        <TextBlock Text="Chave pública fixada (PEM)" Foreground="#888" FontSize="12"/>
        <TextBox x:Name="TxtSignedUpdatePublicKeyPem" Height="92" Margin="0,4,0,12" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                 Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Tamanho máximo para YARA leve (MB)" Foreground="#888" FontSize="12"/>
            <TextBox x:Name="TxtYaraMaxScanSizeMB" Height="30" Margin="0,4,0,0"
                     Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Máximo de entradas por ZIP/JAR" Foreground="#888" FontSize="12"/>
            <TextBox x:Name="TxtArchiveMaxEntries" Height="30" Margin="0,4,0,0"
                     Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Profundidade máxima de arquivos compactados" Foreground="#888" FontSize="12"/>
            <TextBox x:Name="TxtArchiveMaxDepth" Height="30" Margin="0,4,0,0"
                     Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Máximo descompactado por arquivo (MB)" Foreground="#888" FontSize="12"/>
            <TextBox x:Name="TxtArchiveMaxDecompressedMB" Height="30" Margin="0,4,0,0"
                     Background="#111" Foreground="#ddd" BorderBrush="#333" Padding="8,4"/>
          </StackPanel>
        </Grid>

        <WrapPanel Margin="0,0,0,8">
          <CheckBox x:Name="ChkAutoQuarantineKnownMalware" Content="Autoquarentenar malware conhecido" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkSuppressAccessDeniedLog" Content="Suprimir log de acesso negado" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkScanDownloads" Content="Downloads" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkScanDesktop" Content="Desktop" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkScanDocuments" Content="Documents" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkScanAppData" Content="AppData" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkScanStartupLocations" Content="Inicialização" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkEnableYaraRules" Content="Ativar regras YARA leves" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkDeepScanArchives" Content="Varredura profunda em ZIP/JAR/Office macro" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkAnalyzeDocuments" Content="Analisar Office/PDF" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkAnalyzeBrowserExtensions" Content="Analisar extensões de navegador" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkAnalyzeAds" Content="Analisar ADS/Zone.Identifier" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkIncludeRemovableDrives" Content="Full inclui drives removíveis" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkAdvancedPersistenceChecks" Content="Persistência avançada" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkAnalyzeServicesAndDrivers" Content="Serviços/drivers" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkAnalyzeScheduledTasks" Content="Tarefas agendadas" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkUseSafeCache" Content="Usar cache seguro" Margin="0,0,18,8" Foreground="#aaa"/>
          <CheckBox x:Name="ChkEnableTrayProtection" Content="Proteção/tray futura" Margin="0,0,18,8" Foreground="#aaa"/>
        </WrapPanel>

        <TextBlock Foreground="#666" TextWrapping="Wrap" FontSize="11"
                   Text="Observação: alterações entram em vigor no próximo scan. Full pode demorar e consumir CPU/disco. Nada é removido automaticamente exceto malware confirmado por hash ou regra marcada como confirmed=true."/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="BtnCancel" Content="Cancelar" Width="96" Height="34" Margin="0,0,8,0"/>
      <Button x:Name="BtnSave" Content="Salvar" Width="96" Height="34"/>
    </StackPanel>
  </Grid>
</Window>
