<Window x:Class="DataVanger.TextViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="540"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
  <ScrollViewer Background="#080808" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <TextBox x:Name="TxtContent"
             Background="Transparent" Foreground="#c8c8c8"
             FontFamily="Consolas" FontSize="11"
             BorderThickness="0" IsReadOnly="True"
             TextWrapping="NoWrap" AcceptsReturn="True"
             Padding="14,12"/>
  </ScrollViewer>
</Window>
