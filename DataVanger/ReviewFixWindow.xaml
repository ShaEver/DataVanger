<Window x:Class="DataVanger.ReviewFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataVanger — Revisar e Corrigir"
        Width="980" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="DlgBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="Background" Value="#252525"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="DlgBtnPrimary" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
      <Setter Property="Background" Value="#0088bb"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Revisar e Corrigir Achados" FontSize="15" FontWeight="SemiBold"
               Foreground="#00bbdd" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#999" FontSize="11" Margin="0,0,0,12"
               Text="Nada é apagado diretamente. Os itens marcados como 'Quarentenar' vão primeiro para a quarentena criptografada, de onde podem ser restaurados ou excluídos definitivamente. Confirme a ação sugerida de cada item antes de aplicar."/>

    <DataGrid Grid.Row="2" x:Name="DgReview" AutoGenerateColumns="False" CanUserAddRows="False"
              Background="#0b0b0b" Foreground="#dddddd" RowBackground="#101010"
              AlternatingRowBackground="#151515" GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#252525" BorderThickness="0"
              HeadersVisibility="Column" VerticalScrollBarVisibility="Auto">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Aplicar" Width="62"
                                Binding="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <DataGridTextColumn Header="Arquivo" Width="170" IsReadOnly="True"
                            Binding="{Binding FileName}"/>
        <DataGridTextColumn Header="Risco" Width="100" IsReadOnly="True"
                            Binding="{Binding RiskLabel}"/>
        <DataGridTextColumn Header="Score" Width="60" IsReadOnly="True"
                            Binding="{Binding Score}"/>
        <DataGridTemplateColumn Header="Ação sugerida" Width="190">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox Margin="2"
                        SelectedItem="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding DataContext.ActionOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Caminho" Width="*" IsReadOnly="True"
                            Binding="{Binding Path}"/>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
      <Button x:Name="BtnOpenLocation" Content="📂  Abrir local" Style="{StaticResource DlgBtn}"/>
      <Button x:Name="BtnCopyHash" Content="📋  Copiar hash SHA256" Style="{StaticResource DlgBtn}"/>
      <Button x:Name="BtnDetails" Content="🔎  Ver detalhes" Style="{StaticResource DlgBtn}"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="BtnApply" Content="✔  Aplicar ações selecionadas" Style="{StaticResource DlgBtnPrimary}"/>
      <Button x:Name="BtnClose" Content="Fechar" Style="{StaticResource DlgBtn}" Margin="0"/>
    </StackPanel>
  </Grid>
</Window>
