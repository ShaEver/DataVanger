<Window x:Class="DataVanger.ScheduledScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataVanger — Agendar varredura"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Agendar varredura" FontSize="18" FontWeight="Bold" Foreground="#00bbdd" Margin="0,0,0,14"/>

    <StackPanel Grid.Row="1">
      <TextBlock Text="Tipo de agendamento" Foreground="#888" FontSize="12"/>
      <ComboBox x:Name="CmbMode" Height="32" Margin="0,4,0,12" Background="White" Foreground="Black">
        <ComboBoxItem Content="Uma vez, em data e hora específicas" Tag="ONCE" IsSelected="True"/>
        <ComboBoxItem Content="Diariamente" Tag="DAILY"/>
        <ComboBoxItem Content="Semanalmente" Tag="WEEKLY"/>
        <ComboBoxItem Content="Mensalmente" Tag="MONTHLY"/>
        <ComboBoxItem Content="Na inicialização do Windows" Tag="ONSTART"/>
        <ComboBoxItem Content="No logon do usuário" Tag="ONLOGON"/>
        <ComboBoxItem Content="Quando o computador estiver ocioso" Tag="ONIDLE"/>
      </ComboBox>

      <TextBlock Text="Data" Foreground="#888" FontSize="12"/>
      <DatePicker x:Name="DpDate" Height="32" Margin="0,4,0,12" Background="White" Foreground="Black"/>

      <TextBlock Text="Hora (HH:mm)" Foreground="#888" FontSize="12"/>
      <TextBox x:Name="TxtTime" Height="30" Margin="0,4,0,12" Background="White" Foreground="Black" BorderBrush="#555" Padding="8,4"/>

      <TextBlock Text="Dia da semana (usado no modo semanal)" Foreground="#888" FontSize="12"/>
      <ComboBox x:Name="CmbWeekDay" Height="32" Margin="0,4,0,12" Background="White" Foreground="Black">
        <ComboBoxItem Content="Segunda-feira" Tag="MON"/>
        <ComboBoxItem Content="Terça-feira" Tag="TUE"/>
        <ComboBoxItem Content="Quarta-feira" Tag="WED"/>
        <ComboBoxItem Content="Quinta-feira" Tag="THU"/>
        <ComboBoxItem Content="Sexta-feira" Tag="FRI"/>
        <ComboBoxItem Content="Sábado" Tag="SAT"/>
        <ComboBoxItem Content="Domingo" Tag="SUN" IsSelected="True"/>
      </ComboBox>

      <TextBlock Text="Perfil da varredura agendada" Foreground="#888" FontSize="12"/>
      <ComboBox x:Name="CmbProfile" Height="32" Margin="0,4,0,12" Background="White" Foreground="Black">
        <ComboBoxItem Content="Fast"/>
        <ComboBoxItem Content="Deep" IsSelected="True"/>
      </ComboBox>

      <TextBlock Text="Observação: a tarefa usa o Agendador de Tarefas do Windows e executa o DataVanger em modo silencioso." Foreground="#777" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="BtnRemove" Content="Remover tarefa" Width="112" Height="34" Margin="0,0,8,0"/>
      <Button x:Name="BtnCancel" Content="Cancelar" Width="86" Height="34" Margin="0,0,8,0"/>
      <Button x:Name="BtnSave" Content="Agendar" Width="86" Height="34"/>
    </StackPanel>
  </Grid>
</Window>
