<Window x:Class="DataVanger.ModuleStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataVanger — Status dos Módulos (somente leitura)"
        Width="860" Height="640"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0"
               Text="Estado real dos módulos — Active / Prepared / Fallback / Disabled / Stub / Degraded. Somente leitura: não ativa módulos, não altera configurações, não inicia serviços ou varreduras."
               Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <TextBox Grid.Row="1" x:Name="TxtStatus"
             IsReadOnly="True" IsReadOnlyCaretVisible="False"
             AcceptsReturn="True"
             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             TextWrapping="NoWrap"
             FontFamily="Consolas" FontSize="12"
             Background="#111" Foreground="#dddddd" BorderBrush="#333333" Padding="8"/>
  </Grid>
</Window>
