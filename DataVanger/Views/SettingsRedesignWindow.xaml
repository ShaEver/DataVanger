<Window x:Class="DataVanger.Views.SettingsRedesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataVanger — Configurações"
        Width="780" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style x:Key="DlgBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="Background" Value="#252525"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Configurações" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
      <TextBlock Text="Modo de exibição:" VerticalAlignment="Center" Foreground="#9a9a9a"/>
      <ComboBox x:Name="CmbReveal" Width="180" Margin="10,0,0,0" SelectedIndex="0">
        <ComboBoxItem Content="Normal"/>
        <ComboBoxItem Content="Avançado"/>
        <ComboBoxItem Content="Desenvolvedor"/>
      </ComboBox>
    </StackPanel>

    <Border Grid.Row="2" Background="#141414" BorderBrush="#262626" BorderThickness="1"
            CornerRadius="8" Padding="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanelGroups"/>
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="BtnSave" Content="Salvar" Style="{StaticResource DlgBtn}"/>
      <Button x:Name="BtnCancel" Content="Cancelar" Style="{StaticResource DlgBtn}" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
