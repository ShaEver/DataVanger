<Window x:Class="DataVanger.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DataVanger.Localization"
        Title="{x:Static loc:OnboardingLabels.WindowTitle}"
        Width="560" Height="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0d0d0d"
        Foreground="#e0e0e0"
        FontFamily="Segoe UI"
        Icon="pack://application:,,,/app.ico">
  <Window.Resources>
    <Style x:Key="DlgBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#e0e0e0"/>
      <Setter Property="Background" Value="#252525"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource DlgBtn}">
      <Setter Property="Background" Value="#0088bb"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{x:Static loc:OnboardingLabels.Header}"
               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>

    <TextBlock Grid.Row="1" Text="{x:Static loc:OnboardingLabels.Intro}"
               TextWrapping="Wrap" Foreground="#b0b0b0" Margin="0,0,0,16"/>

    <StackPanel Grid.Row="2">
      <CheckBox Content="{x:Static loc:OnboardingLabels.RealtimeOption}"
                IsChecked="{Binding EnableRealtimeProtection, Mode=TwoWay}"
                Foreground="#e0e0e0" Margin="0,6,0,6"/>
      <CheckBox Content="{x:Static loc:OnboardingLabels.AutoQuarantine}"
                IsChecked="{Binding AutoQuarantineKnownMalware, Mode=TwoWay}"
                Foreground="#e0e0e0" Margin="0,6,0,6"/>
      <CheckBox Content="{x:Static loc:OnboardingLabels.StartWithWindows}"
                IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                Foreground="#e0e0e0" Margin="0,6,0,6"/>
    </StackPanel>

    <TextBlock Grid.Row="3" Text="{x:Static loc:OnboardingLabels.SafetyNote}"
               TextWrapping="Wrap" FontSize="11" Foreground="#888" Margin="0,12,0,0"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnSkip" Content="{x:Static loc:OnboardingLabels.Skip}"
              Style="{StaticResource DlgBtn}"/>
      <Button x:Name="BtnApply" Content="{x:Static loc:OnboardingLabels.Apply}"
              Style="{StaticResource PrimaryBtn}" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
